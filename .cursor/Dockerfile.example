# Polopine UI – advanced Cloud Agents environment (Dockerfile)
#
# This file is OFF by default. Cursor only uses it when .cursor/environment.json
# references it (see .cursor/environment.json.example for the matching config).
#
# Why you would switch on the Dockerfile path:
#   - You want Playwright + Chromium pre-installed for visual / E2E checks
#   - You want a specific Node version pinned across every cloud agent run
#   - You want reproducible, snapshot-cached cold starts across the team
#
# IMPORTANT
#   - Do NOT `COPY` your project source. Cursor checks out the right commit for you.
#   - This image only installs system + language tooling and warms caches.

FROM node:22-bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive \
    NODE_ENV=development \
    NPM_CONFIG_FUND=false \
    NPM_CONFIG_AUDIT=false

# System packages the agent might need at runtime (Chromium deps for Playwright, etc.)
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        git \
        jq \
        openssh-client \
        tini \
        libnss3 \
        libatk1.0-0 \
        libatk-bridge2.0-0 \
        libcups2 \
        libdrm2 \
        libxkbcommon0 \
        libxcomposite1 \
        libxdamage1 \
        libxfixes3 \
        libxrandr2 \
        libgbm1 \
        libpango-1.0-0 \
        libcairo2 \
        libasound2 \
    && rm -rf /var/lib/apt/lists/*

RUN npm install -g npm@latest vite@latest typescript@latest vitest@latest

WORKDIR /workspace
